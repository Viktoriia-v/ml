# Copy this file to .env and fill in real values.
# .env is gitignored.

# --- LLM access (OpenRouter is OpenAI-compatible) ---
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional headers OpenRouter recommends for analytics/leaderboards:
OPENROUTER_HTTP_REFERER=https://github.com/your-handle/thesis-fake-news
OPENROUTER_X_TITLE=Thesis Fake News Classifier

# --- Optional alternates ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- HuggingFace (only needed for gated models / private datasets) ---
# HUGGINGFACE_TOKEN=

# --- Weights & Biases (optional experiment tracking) ---
# WANDB_API_KEY=
WANDB_PROJECT=thesis-fake-news
WANDB_MODE=disabled       # change to "online" to enable
